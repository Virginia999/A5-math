# ==================== 数据库配置 ====================
DATABASE_URL="postgresql://用户名:密码@localhost:5432/知识库数据库名?schema=public"

# ==================== JWT 配置 ====================
JWT_SECRET="你的超级密钥-请使用强随机字符串"
JWT_EXPIRES_IN="7d"

# ==================== 服务器配置 ====================
PORT=3000
NODE_ENV="development"

# ==================== CORS 配置 ====================
CORS_ORIGIN="http://localhost:3001"

# ==================== AI 配置 - OpenAI ====================
OPENAI_API_KEY="your-openai-api-key"
OPENAI_API_BASE_URL="https://api.openai.com/v1"
OPENAI_DEFAULT_MODEL="gpt-3.5-turbo"

# ==================== AI 配置 - 通义千问 ====================
QWEN_API_KEY="your-qwen-api-key"
QWEN_API_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
QWEN_DEFAULT_MODEL="qwen-turbo"

# ==================== AI 配置 - Claude ====================
CLAUDE_API_KEY="your-claude-api-key"
CLAUDE_API_BASE_URL="https://api.anthropic.com/v1"
CLAUDE_DEFAULT_MODEL="claude-3-haiku-20240307"

# ==================== AI 通用配置 ====================
AI_DEFAULT_PROVIDER="openai"
AI_REQUEST_TIMEOUT=30000

# ==================== 向量嵌入配置 ====================
EMBEDDING_PROVIDER="openai"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=100

# ==================== RAG 配置 ====================
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7
RAG_MAX_CONTEXT_LENGTH=4000
RAG_HYBRID_SEARCH=true
RAG_RERANKING=true

# ==================== 知识图谱配置 ====================
KG_MAX_NODES=20
KG_MAX_RELATIONS=10
KG_CONFIDENCE_THRESHOLD=0.6

# ==================== 推荐系统配置 ====================
REC_CONTENT_WEIGHT=0.4
REC_COLLAB_WEIGHT=0.3
REC_KG_WEIGHT=0.3
REC_DEFAULT_LIMIT=10

# ==================== Redis 配置（可选） ====================
REDIS_URL="redis://localhost:6379"

# ==================== 日志配置 ====================
LOG_LEVEL="info"
LOG_FILE="logs/app.log"
